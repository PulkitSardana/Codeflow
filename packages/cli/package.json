{
  "name": "codeflow",
  "version": "0.1.0",
  "description": "Local-first execution intelligence CLI and viewer for Node.js and TypeScript.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/viewer/**/*",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codeflow": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codeflow/analyzer": "0.1.0",
    "@codeflow/exporters": "0.1.0",
    "@codeflow/integration-playwright": "0.1.0",
    "@codeflow/recorder": "0.1.0",
    "@codeflow/session": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
