{
  "name": "@codeflow/cli",
  "version": "0.1.0",
  "description": "Record Node.js executions, inspect runtime behavior, and compare performance regressions locally.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PulkitSardana/Codeflow.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/PulkitSardana/Codeflow#readme",
  "bugs": {
    "url": "https://github.com/PulkitSardana/Codeflow/issues"
  },
  "keywords": [
    "codeflow",
    "execution tracing",
    "performance regression",
    "nodejs",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/viewer/**/*",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codeflow": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codeflow/analyzer": "0.1.0",
    "@codeflow/exporters": "0.1.0",
    "@codeflow/integration-playwright": "0.1.0",
    "@codeflow/recorder": "0.1.0",
    "@codeflow/session": "0.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
